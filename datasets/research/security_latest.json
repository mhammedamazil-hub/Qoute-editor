        "os_boundary": true,
        "escaped": false,
        "error": "",
        "timed_out": false
      },
      {
        "probe": "read_production_db",
        "mode": "namespace",
        "os_boundary": true,
        "escaped": false,
        "error": "",
        "timed_out": false
      },
      {
        "probe": "spawn_process",
        "mode": "namespace",
        "os_boundary": true,
        "escaped": false,
        "error": "",
        "timed_out": false
      },
