{
  "modes": [
    {
      "name": "namespace",
      "os_boundary": true,
      "note": "user+mount+pid+net namespace; /home masked with tmpfs"
    },
    {
      "name": "guard",
      "os_boundary": false,
      "note": "subprocess + hardened audit hook; not an OS boundary"
    }
  ],
  "probes": {
    "namespace": [
      {
        "probe": "relative_read_etc",
        "mode": "namespace",
        "os_boundary": true,
        "escaped": false,
        "error": "",
        "timed_out": false
      },
      {
        "probe": "relative_read_repo",
        "mode": "namespace",
        "os_boundary": true,
        "escaped": false,
        "error": "",
        "timed_out": false
      },
      {
