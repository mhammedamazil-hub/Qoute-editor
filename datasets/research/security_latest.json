        "os_boundary": true,
        "escaped": false,
        "error": "",
        "timed_out": false
      },
      {
        "probe": "kill_harness",
        "mode": "namespace",
        "os_boundary": true,
        "escaped": false,
        "error": "",
        "timed_out": false
      },
      {
        "probe": "infinite_loop",
        "mode": "namespace",
        "os_boundary": true,
        "escaped": false,
        "error": "timeout",
        "timed_out": true
      },
      {
        "probe": "memory_bomb",
        "mode": "namespace",
        "os_boundary": true,
