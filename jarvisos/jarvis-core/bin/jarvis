#!/usr/bin/env python3
"""JARVIS command-line client.

Usage:
  jarvis open blender            # any natural-language command
  jarvis stop                    # emergency automation stop
  jarvis status                  # core/ai/engine state
  jarvis stats                   # cpu/mem/disk/battery snapshot
  jarvis config ui.show foo      # get/set a config key (get when no value)
  jarvis --local open blender    # bypass daemon (debug)

Talks to jarvis-core over its Unix socket; falls back to in-process Core
when the daemon isn't running (e.g. headless debug).
"""
import json
import os
import socket
import sys

sys.path.insert(0, "/usr/lib/jarvisos")
sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)),
                                ".."))


def socket_path():
    runtime = os.environ.get("XDG_RUNTIME_DIR", "")
    if runtime and os.path.isdir(runtime):
        return os.path.join(runtime, "jarvis.sock")
    return os.path.join(os.path.expanduser("~"), ".local", "share",
                        "jarvisos", "jarvis.sock")


def via_daemon(payload):
    path = socket_path()
    if not os.path.exists(path):
        return None
    try:
        sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        sock.settimeout(120)
        sock.connect(path)
        sock.sendall((json.dumps(payload) + "\n").encode())
        buf = b""
        while b"\n" not in buf:
            chunk = sock.recv(65536)
            if not chunk:
                break
            buf += chunk
        sock.close()
        return json.loads(buf.decode("utf-8", "replace"))
    except (OSError, ValueError):
        return None


def main():
    args = sys.argv[1:]
    if not args or args[0] in ("-h", "--help"):
        print(__doc__)
        return 0
    local = False
    if args[0] == "--local":
        local = True
        args = args[1:]
    if not args:
        print("usage: jarvis <command...>")
        return 2

    if args[0] == "config" and len(args) >= 2:
        from jarvis.config import get_config
        config = get_config()
        if len(args) == 2:
            print(json.dumps(config.get(args[1]), indent=2))
        else:
            value = args[2]
            try:
                value = json.loads(args[2])
            except ValueError:
                pass
            config.set(args[1], value)
            print("set %s" % args[1])
        return 0

    text = " ".join(args)
    if text.strip().lower() in ("stop", "stop automation"):
        resp = None if local else via_daemon({"cmd": "stop"})
        if resp is None:
            from jarvis import Core
            Core().engine.stop()
            print("Automation stopped.")
        else:
            print(resp.get("say", ""))
        return 0
    if text.strip().lower() == "status":
        resp = None if local else via_daemon({"cmd": "status"})
        print(json.dumps(resp or {"ok": False, "say": "daemon offline"},
                         indent=2))
        return 0
    if text.strip().lower() == "stats":
        resp = None if local else via_daemon({"cmd": "stats"})
        print(json.dumps((resp or {}).get("data", resp), indent=2))
        return 0

    resp = None if local else via_daemon({"cmd": "text", "text": text})
    if resp is None:  # daemon offline → in-process Core
        from jarvis import Core
        core = Core()
        result = core.handle_text(text)
        print(result.say)
        if result.needs_confirm:
            try:
                yes = input(result.confirm_question + " [y/N] ").strip(
                ).lower() == "y"
            except (EOFError, KeyboardInterrupt):
                yes = False
            print(core.confirm(result.confirm_token, yes).say if yes
                  else "Cancelled.")
        return 0 if result.ok else 1

    print(resp.get("say", ""))
    if resp.get("needs_confirm"):
        try:
            yes = input(resp.get("confirm_question",
                                 "Confirm?") + " [y/N] ").strip().lower()
            if yes == "y":
                resp2 = via_daemon({"cmd": "confirm",
                                    "token": resp.get("confirm_token"),
                                    "yes": True})
                print((resp2 or {}).get("say", ""))
        except (EOFError, KeyboardInterrupt):
            pass
    return 0 if resp.get("ok") else 1


if __name__ == "__main__":
    sys.exit(main())
