#!/usr/bin/env python3
"""Clap detector daemon: mic → patterns → Core pipeline.

Runs only while gestures.clap_enabled is true. Re-reads config every 5 s
so the Settings toggle applies without restart.
"""
import sys
import threading
import time

sys.path.insert(0, "/usr/lib/jarvisos")

from jarvis import Core
from jarvis.config import get_config
from jarvis.gestures import ClapDetector
from jarvis import notify as notify_mod


def main():
    config = get_config()
    core = Core(config=config)
    stop_flag = threading.Event()

    def on_event(pattern):
        mapping = config.get("gestures.clap_map", {}) or {}
        action = mapping.get(pattern, "")
        print("clap: %s → %s" % (pattern, action), flush=True)
        if not action:
            return
        result = core.handle_clap(pattern)
        notify_mod.send("JARVIS 🎙", "%s: %s" % (pattern, result.say))
        print(result.say, flush=True)

    print("jarvis-clapd starting (enabled=%s)" % config.get(
        "gestures.clap_enabled", True), flush=True)
    while True:
        config.reload()
        if not config.get("gestures.clap_enabled", True):
            time.sleep(5)
            continue
        detector = ClapDetector(
            sensitivity=config.get("gestures.sensitivity", 3.0),
            double_window_ms=config.get("gestures.double_window_ms", 700),
            cooldown_ms=config.get("gestures.cooldown_ms", 1800))
        try:
            detector.listen_forever(on_event, stop_flag)
        except RuntimeError as exc:
            print("jarvis-clapd: %s — retrying in 10 s" % exc, flush=True)
            time.sleep(10)
        except KeyboardInterrupt:
            break
    return 0


if __name__ == "__main__":
    sys.exit(main())
