#!/usr/bin/env python3
"""Push-to-talk voice command: record → transcribe → Core → reply.

Usage: jarvis-listen [--seconds 6]
"""
import sys

sys.path.insert(0, "/usr/lib/jarvisos")

from jarvis import Core
from jarvis.config import get_config
from jarvis.voice import stt, tts


def main():
    seconds = 6
    args = sys.argv[1:]
    if "--seconds" in args:
        try:
            seconds = int(args[args.index("--seconds") + 1])
        except (ValueError, IndexError):
            pass
    config = get_config()
    if not config.get("privacy.send_voice_to_cloud", True):
        # force local-only
        config.set("voice.stt_engine", "vosk")
        config.reload()
    print("Listening for %d seconds… speak now." % seconds)
    text, engine = stt.listen_once(seconds, config)
    if not text:
        print("I didn't hear anything (%s)." % engine)
        return 1
    print("Heard (%s): %s" % (engine, text))
    core = Core(config=config)
    result = core.handle_voice(text)
    print(result.say)
    if result.needs_confirm:
        try:
            yes = input(result.confirm_question + " [y/N] ").strip().lower()
            if yes == "y":
                result = core.confirm(result.confirm_token, True)
                print(result.say)
        except (EOFError, KeyboardInterrupt):
            pass
    tts.speak(result.say, config)
    return 0 if result.ok else 1


if __name__ == "__main__":
    sys.exit(main())
